# Servidor y Seguridad
PORT=3000
NODE_ENV=development
# Podés separar múltiples orígenes con coma (ej: http://localhost:5173,https://segurosautoya.com)
CORS_ORIGIN=http://localhost:5173
QUOTE_TIMEOUT_MS=9000
QUOTE_CACHE_TTL_SEC=300

# ==========================================================
# Mercantil Andina (modo: mock | live | off)
# ==========================================================
MERCANTIL_MODE=mock
MERCANTIL_BASE_URL=https://apidev.mercantilandina.com.ar
MERCANTIL_AUTH_PATH=/credenciales/v2/
# Completar cuando descargues el Swagger de cotización de Mercantil Andina
MERCANTIL_QUOTE_PATH=
MERCANTIL_CLIENT_ID=api-clientes-login
MERCANTIL_USER=
MERCANTIL_PASSWORD=
MERCANTIL_SUBSCRIPTION_KEY=

# ==========================================================
# Grupo Sancor Seguros (modo: mock | live | off)
# ==========================================================
SANCOR_MODE=mock
SANCOR_BASE_URL=https://external-pre-api.gruposancorseguros.com/apissa/pre-catalog
SANCOR_CLIENT_ID=
SANCOR_USERNAME=
SANCOR_PASSWORD=
SANCOR_APP_CLIENT=SegurosAutoYa
SANCOR_PRODUCER_CODE=10001
SANCOR_UPPER_PRODUCER_CODE=10000
SANCOR_PRODUCT_CODE=24
SANCOR_VIGENCY_CODE=1
SANCOR_PAYMENT_PERIODICITY_CODE=5
SANCOR_POLICY_QUOTAS=12
SANCOR_IVA_CONDITION_CODE=4
